# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sts_pm?schema=public"

# ─── App ─────────────────────────────────────────────────────────────────────
# Public base URL of the app (used in emails, receipts, signed links).
APP_URL="http://localhost:3000"
# Secret for NextAuth JWT/session encryption. Generate: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-generate-a-real-secret"
NEXTAUTH_URL="http://localhost:3000"
# Secret used to sign local file-access URLs. Generate: openssl rand -base64 32
FILE_SIGNING_SECRET="change-me-too"
# Shared secret for the scheduler endpoints (/api/cron/*); callers send it as
# the x-cron-secret header. Leave blank to allow unauthenticated calls in dev.
CRON_SECRET=""

# ─── File storage ────────────────────────────────────────────────────────────
# "local" writes files to ./.storage and serves them via signed app URLs.
# "s3" uses any S3-compatible provider (AWS S3, Cloudflare R2, MinIO, ...).
STORAGE_DRIVER="local"
S3_BUCKET=""
S3_REGION="us-west-1"
S3_ENDPOINT=""            # leave blank for AWS; set for R2/MinIO
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ─── Payments (Stripe) ───────────────────────────────────────────────────────
# "mock" simulates ACH/card payments end-to-end with no keys required.
# "stripe" uses the real Stripe API.
PAYMENTS_DRIVER="mock"
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ─── Email ───────────────────────────────────────────────────────────────────
# "mock" logs emails to the console and records them in the Notification table.
# "resend" sends through the Resend API.
EMAIL_DRIVER="mock"
RESEND_API_KEY=""
EMAIL_FROM="STS Property Management <no-reply@example.com>"

# ─── SMS ─────────────────────────────────────────────────────────────────────
# "mock" logs SMS to the console and records them in the Notification table.
# "twilio" sends through the Twilio REST API.
SMS_DRIVER="mock"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
